# Copy to .env and fill in real values. Never commit .env itself (gitignored).

# Postgres connection string. Locally: postgresql://<your-macos-username>@localhost:5432/caption_contest
# (see README's "Running locally" for setup). In production: your hosted Postgres
# (Supabase, Neon, Vercel Postgres, etc.) connection string.
DATABASE_URL=""

# Password for the /admin comic-upload page. Pick a real one — "changeme" is a
# placeholder, not meant to ship.
ADMIN_PASSWORD=""

# Bearer token for GET /api/cron/freeze. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Not meant to be memorized — only copy-pasted into whatever scheduler calls that
# endpoint (Vercel Cron reads this automatically if deployed there, see vercel.json).
CRON_SECRET=""

# Optional. Vercel Blob read/write token for comic image uploads — create a Blob
# store in your Vercel project's Storage tab and this gets set automatically for
# linked deployments. Leave unset for local dev: uploads fall back to local disk
# under public/comics/ (see lib/storage.ts).
# BLOB_READ_WRITE_TOKEN=""
